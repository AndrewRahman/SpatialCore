+namespace
+{
+    // Renders a unit-amplitude test signal (DC when freqHz == 0, else a sine) at the given
+    // distance and returns, per channel, the least-squares gain of the output onto the input
+    // (<out, in> / <in, in>) over the last 100 blocks, plus the relative residual
+    // (|out - gain x in| / |out|) so a filter's phase shift cannot hide in the gain.
+    struct ChannelFit { std::vector<float> gain; std::vector<float> residual; };
+
+    ChannelFit renderFit (OutputFormat format, int numChannels, float azDeg, float elDeg,
+                          float distance, float freqHz)
+    {
+        RenderEngine engine;
+        engine.prepare (kSampleRate, kBlockSize);
+        engine.setOutputFormat (format);
+
+        std::vector<float> mono ((size_t) kBlockSize, 1.0f);
+        std::vector<float> tapFade ((size_t) kBlockSize, 1.0f);
+        std::vector<float> distGain ((size_t) kBlockSize, 1.0f);
+
+        RenderSources sources;
+        sources.numSamples = kBlockSize;
+        sources.monoBuffers[0] = mono.data();
+        sources.tapFadeGainPerSample[0] = tapFade.data();
+        sources.distGainPerSample[0] = distGain.data();
+        sources.objectLive[0] = true;
+        sources.objects[0].azimuthDeg = azDeg;
+        sources.objects[0].elevationDeg = elDeg;
+        sources.objects[0].distance = distance;
+        sources.objects[0].enabled = true;
+
+        std::vector<std::vector<float>> channels ((size_t) numChannels, std::vector<float> ((size_t) kBlockSize, 0.0f));
+        std::vector<float*> ptrs ((size_t) numChannels);
+        for (int c = 0; c < numChannels; ++c)
+            ptrs[(size_t) c] = channels[(size_t) c].data();
+
+        constexpr int kMeasureBlocks = 100;
+        std::vector<double> xy ((size_t) numChannels, 0.0), yy ((size_t) numChannels, 0.0);
+        double xx = 0.0;
+        long sampleIndex = 0;
+
+        for (int b = 0; b < kSettleBlocks; ++b)
+        {
+            for (int s = 0; s < kBlockSize; ++s, ++sampleIndex)
+                mono[(size_t) s] = (freqHz <= 0.0f) ? 1.0f
+                    : (float) std::sin (2.0 * 3.14159265358979323846 * (double) freqHz * (double) sampleIndex / kSampleRate);
+
+            RenderBlockContext ctx;
+            ctx.sampleRate = kSampleRate;
+            ctx.engineComputesGains = true;
+            ctx.engineDerivesDispatch = true;
+            engine.renderBlock (sources, ctx, ptrs.data(), numChannels);
+
+            if (b >= kSettleBlocks - kMeasureBlocks)
+                for (int s = 0; s < kBlockSize; ++s)
+                {
+                    xx += (double) mono[(size_t) s] * (double) mono[(size_t) s];
+                    for (int c = 0; c < numChannels; ++c)
+                    {
+                        const double y = (double) channels[(size_t) c][(size_t) s];
+                        xy[(size_t) c] += (double) mono[(size_t) s] * y;
+                        yy[(size_t) c] += y * y;
+                    }
+                }
+        }
+
+        ChannelFit fit { std::vector<float> ((size_t) numChannels), std::vector<float> ((size_t) numChannels) };
+        for (int c = 0; c < numChannels; ++c)
+        {
+            const double g = xy[(size_t) c] / xx;
+            const double res = yy[(size_t) c] - g * g * xx;   // |out|^2 - |g x in|^2, the orthogonal part
+            fit.gain[(size_t) c] = (float) g;
+            fit.residual[(size_t) c] = (yy[(size_t) c] > 1.0e-12)
+                ? (float) std::sqrt (std::max (0.0, res) / yy[(size_t) c]) : 0.0f;
+        }
+        return fit;
+    }
+}
