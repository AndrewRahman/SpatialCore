+    // distance. The plain AmbiX stream has the same ratios at every distance and frequency.
+    // Tolerance: gain ratio within 1e-4 of evalSH (n) / evalSH (0); least-squares residual
+    // (anything the gain cannot explain, i.e. a phase shift) below 1e-3 of the channel's RMS.
+    constexpr float kResidualTol = 1.0e-3f;
+    const float distances[] = { 0.05f, 0.15f, 0.5f, 1.0f };
+    const float freqs[] = { 0.0f, 50.0f };
+
+    struct Fmt { OutputFormat format; int order; const char* name; };
+    const Fmt formats[] = {
+        { OutputFormat::AmbisonicsFOA, 1, "FOA" },
+        { OutputFormat::AmbisonicsHOA, 3, "3OA" },
+        { OutputFormat::Ambisonics6OA, 6, "6OA" },
+    };
+    const float azDeg = 30.0f, elDeg = 20.0f;
+
+    for (const auto& f : formats)
+    {
+        const int numCh = (f.order + 1) * (f.order + 1);
+        const float azRad = juce::degreesToRadians (azDeg);
+        const float elRad = juce::degreesToRadians (elDeg);
+
+        for (const float freq : freqs)
+            for (const float dist : distances)
+            {
+                DYNAMIC_SECTION (f.name << ", " << freq << " Hz, distance " << dist)
+                {
+                    const auto fit = renderFit (f.format, numCh, azDeg, elDeg, dist, freq);
+                    const float w = fit.gain[(size_t) kW];
+                    REQUIRE (w > 0.0f);
+
+                    for (int n = 1; n < numCh; ++n)
+                    {
+                        const float expected = evalSH (n, azRad, elRad) / evalSH (0, azRad, elRad);
+                        INFO ("ACN " << n << " expected ratio " << expected << " got " << fit.gain[(size_t) n] / w);
+                        CHECK (std::abs (fit.gain[(size_t) n] / w - expected) < kRatioTol);
+                        CHECK (fit.residual[(size_t) n] < kResidualTol);
+                    }
+                }
+            }
+    }
+}
